enum ReservationStatus {
  BOOKED
  ARRIVED
  SEATED
  COMPLETED
  NO_SHOW
  CANCELLED
}

model Reservation {
  id         Int               @id @default(autoincrement())
  date       DateTime
  tableId    Int
  table      Table             @relation(fields: [tableId], references: [id])
  memberId   Int
  member     Member            @relation(fields: [memberId], references: [id])

  // NEW
  partySize  Int?
  status     ReservationStatus @default(BOOKED)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([date])
  @@unique([tableId, date]) // DB-level double-booking guard
}

// OPTIONAL (for floorplan editing later):
enum TableShape {
  SQUARE
  RECTANGLE
  CIRCLE
}

model Table {
  id           Int     @id @default(autoincrement())
  number       Int
  floorId      Int?
  capacity     Int?

  // NEW layout fields (nullable; safe to add now)
  x            Int?
  y            Int?
  width        Int?
  height       Int?
  rotation     Int?
  shape        TableShape?
  label        String?

  reservations Reservation[]
}
